{
  "name": "kiwoom-stock-pet",
  "private": true,
  "version": "1.0.0",
  "description": "나만의 주식펫을 키움 — 소수점 주식 적립을 펫 키우기로 습관화하는 모의 서비스",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"node --watch server/index.js\" \"vite --host\"",
